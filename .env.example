# Copy to .env (`make setup` does this). Never commit .env.

# Paths below are inside the api container; ./.data is mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated origins allowed by CORS (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Host port for the API.
API_PORT=8000

# 1 = run the whole system with no API key and deterministic output (used by later phases).
MOCK_AI=1

# LLM provider (litellm service), used by later phases.
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=

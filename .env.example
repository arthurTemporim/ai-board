# Copy to .env (`make setup` does this). Never commit .env.

# Paths below are inside the api container; ./.data is mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated origins allowed by CORS (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Host port for the API.
API_PORT=8000

# 1 = run the whole system with no API key and deterministic output (MockLLM, hash embedder).
# Set to 0 to use the real models configured below.
MOCK_AI=1

# ---- Language models -----------------------------------------------------------------------
# Default setup: a litellm proxy in front of local (Ollama) models, spoken to in OpenAI format.
# Chat models on the proxy: gemma4:12b, llama3.2:3b, lfm2.5:8b, nimble:9b.
# The active prompt versions (ai/prompts/registry.yaml) use llama3.2:3b.
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=
LLM_PROVIDER=openai

# How structured output is requested. Ollama-backed models accept json_schema and json_mode but
# reject tool calling (function_calling).
LLM_STRUCTURED_METHOD=json_schema

# Seconds per request. Local models are slow: a 3B model answers in seconds, a 12B one can take 30+.
LLM_TIMEOUT_SECONDS=180

# Optional: run every prompt on one model instead of the model in its frontmatter (A/B tests).
# AI_MODEL_OVERRIDE=gemma4:12b

# Alternative: Claude directly (LLM_PROVIDER=anthropic, then prompt version 1 is the one written for it).
# ANTHROPIC_API_KEY=

# ---- Embeddings ----------------------------------------------------------------------------
# litellm: the proxy's embedding models (nomic-embed-text-v2-moe:latest, qwen3-embedding:8b).
# fastembed: a local ONNX model inside the container, no proxy needed.
EMBEDDING_PROVIDER=litellm
# nomic: 768 dimensions, fast. qwen3-embedding:8b ranked 7/7 duplicates in the top 3 on the seed data
# (nomic: 6/7) but is about 14x slower and 4096-dimensional.
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# MCP servers (started by the API process as stdio child processes).
# With EMBEDDING_PROVIDER=fastembed the model (default BAAI/bge-small-en-v1.5) is downloaded on
# first use into FASTEMBED_CACHE_DIR.
# FASTEMBED_CACHE_DIR=/data/fastembed
# Config files (defaults are config/rubric.yaml and config/comms_templates.yaml).
# RUBRIC_PATH=
# COMMS_TEMPLATES_PATH=

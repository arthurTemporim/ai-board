# Copy to .env (`make setup` does this). Never commit .env.

# Paths below are inside the api container; ./.data is mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated origins allowed by CORS (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Host port for the API.
API_PORT=8000

# 1 = run the whole system with no API key and deterministic output (MockLLM).
# Set to 0 to call a real model; then one of the two options below is required.
MOCK_AI=1

# Real model, option A: talk to Anthropic directly.
ANTHROPIC_API_KEY=

# Real model, option B: go through a litellm proxy (its Anthropic-format endpoint). When
# LITELLM_BASE_URL is set it is used instead of option A. Example: http://host.docker.internal:4000
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Optional: force every prompt onto one model name (e.g. a litellm alias) instead of the
# model in each prompt's frontmatter.
AI_MODEL_OVERRIDE=

# Optional: per-request timeout in seconds, and tries per call for transient failures.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_ATTEMPTS=3
